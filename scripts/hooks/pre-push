#!/usr/bin/env bash
# Local lane into main (docs/git-flow.md, 進入 main). A push to main is allowed when the pushed commits
#   1. are one change each (no merge commits), follow Conventional Commits and carry no AI-platform
#      attribution (check-main-commits.sh),
#   2. each touch one release unit, or declare Coupled-Change: in the last paragraph
#      (check-commit-body.sh --only units),
#   3. contain no change that must go through a PR: release governance paths (.github/CODEOWNERS) or a
#      breaking change ("!" or a BREAKING CHANGE footer), and
#   4. pass lint, build and tests over the affected packages (scripts/ci/run-affected.sh).
# Pushes to other branches are not checked here; release/* is written by the release scripts, and a human
# change to it goes through a PR. Skipping with --no-verify is caught by the nightly history check.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
zero=0000000000000000000000000000000000000000

# CODEOWNERS patterns as shell globs: a leading "/" anchors at the root, a trailing "/" means everything below.
governed() { # governed <file>
  local f="$1" p
  while read -r p _; do
    [[ -z "$p" || "$p" == \#* ]] && continue
    p="${p#/}"; [[ "$p" == */ ]] && p="$p*"
    # shellcheck disable=SC2053
    [[ "$f" == $p ]] && return 0
  done < .github/CODEOWNERS
  return 1
}

status=0
while read -r _ local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == refs/heads/main && "$local_sha" != "$zero" ]] || continue
  [[ "$remote_sha" != "$zero" ]] || { printf '%s\n' >&2 "pre-push：遠端還沒有 main，略過檢查"; continue; }
  range="$remote_sha..$local_sha"
  # the checks below need bash 4 (scripts/lib/common.sh); macOS ships 3.2 as /bin/bash
  if (( BASH_VERSINFO[0] < 4 )); then
    printf '%s\n' >&2 "pre-push：推上 main 要用 bash 4 以上檢查，目前是 ${BASH_VERSION}。用 brew install bash 安裝新版，並讓 PATH 裡的 bash 指向它。"
    status=1; break
  fi

  bash scripts/ci/check-main-commits.sh "$range" || status=1
  while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    bash scripts/ci/check-commit-body.sh --only units --commit "$c" >/dev/null \
      || { printf '%s\n' >&2 "  ↑ ${c:0:7} $(git log -1 --format=%s "$c")"; status=1; }
  done < <(git rev-list --no-merges "$range")

  while IFS= read -r f; do
    [[ -n "$f" ]] && governed "$f" && { printf '%s\n' >&2 "✗ $f 是發布治理路徑（.github/CODEOWNERS），這個變更要走 PR"; status=1; }
  done < <(git diff --name-only "$range")
  while IFS=$'\t' read -r c subject; do
    [[ -n "$c" ]] || continue
    if [[ "$subject" =~ ^[a-z]+(\([^\)]*\))?!: ]] || git log -1 --format=%b "$c" | grep -qE '^BREAKING[ -]CHANGE:'; then
      printf '%s\n' >&2 "✗ ${c:0:7} 是破壞性變更，會跳主版，要走 PR 留下討論紀錄"; status=1
    fi
  done < <(git log --no-merges --format=$'%H\t%s' "$range")
  (( status == 0 )) || break

  printf '%s\n' "pre-push：lint、建置與測試受影響範圍（since ${remote_sha:0:7}）"
  pnpm lint && AFFECTED_SINCE="$remote_sha" WITH_DEPS=1 bash scripts/ci/run-affected.sh build \
    && AFFECTED_SINCE="$remote_sha" bash scripts/ci/run-affected.sh test || status=1
done
(( status == 0 )) || printf '%s\n' >&2 "pre-push：沒有推送。一定走 PR 的變更改開 PR，其餘修正後再推。"
exit "$status"
